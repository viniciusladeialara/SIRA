      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(sira_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95 Latência", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(sira_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50 Latência", "refId": "B" }
