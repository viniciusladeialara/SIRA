# ==============================================================================
# SIRA - Sistema Integrado de Recursos Acadêmicos
# Arquivo de Referência de Variáveis de Ambiente (.env.example)
# ==============================================================================

# Configurações de Ambiente
NODE_ENV=development

# Configurações do PostgreSQL
POSTGRES_DB=sira
POSTGRES_USER=sira_admin
POSTGRES_PASSWORD=Sira@2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sira_admin:Sira@2026@localhost:5432/sira?schema=core
DATABASE_TEST_URL=postgresql://sira_admin:Sira@2026@localhost:5432/sira_teste?schema=core

# Configurações do pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@sira.com
PGADMIN_DEFAULT_PASSWORD=Admin@2026
PGADMIN_PORT=8080

# Configurações do Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Configurações de Autenticação JWT (Pré-configuradas para Fase 2)
JWT_SECRET=sira_super_secret_jwt_key_2026_dev_env_only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=sira_super_secret_refresh_token_key_2026_dev
JWT_REFRESH_EXPIRES_IN=7d
