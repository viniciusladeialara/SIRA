// ==============================================================================
// SCHEMA WORKFLOW (PRD Enterprise V2 - EPIC 4 & EPIC 5)
// ==============================================================================

model fluxos {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       String         @unique @db.VarChar(50)
  nome         String         @db.VarChar(100)
  descricao    String?
  ativo        Boolean        @default(true)
  criado_em    DateTime       @default(now()) @db.Timestamptz(6)
  etapas       etapas[]
  solicitacoes solicitacoes[]

  @@schema("workflow")
}

model etapas {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fluxo_id         String       @db.Uuid
  ordem            Int
  nome             String       @db.VarChar(100)
  perfil_aprovador String       @db.VarChar(50)
  obrigatoria      Boolean      @default(true)
  fluxos           fluxos       @relation(fields: [fluxo_id], references: [id], onDelete: Cascade)
  aprovacoes       aprovacoes[]

  @@schema("workflow")
}

model solicitacoes {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fluxo_id       String        @db.Uuid
  unidade_id     String?       @db.Uuid
  solicitante_id String        @db.Uuid
  tipo           String        @db.VarChar(50)
  status         String        @default("pendente") @db.VarChar(50)
  dados_jsonb    Json
  criado_em      DateTime      @default(now()) @db.Timestamptz(6)
  atualizado_em  DateTime      @default(now()) @db.Timestamptz(6)
  fluxos         fluxos        @relation(fields: [fluxo_id], references: [id], onDelete: Cascade)
  aprovacoes     aprovacoes[]
  assinaturas    assinaturas[]
  historicos     historicos[]

  @@index([status], map: "idx_solicitacoes_status")
  @@index([solicitante_id], map: "idx_solicitacoes_solicitante")
  @@schema("workflow")
}

model aprovacoes {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacao_id String       @db.Uuid
  etapa_id       String       @db.Uuid
  aprovador_id   String       @db.Uuid
  decisao        String       @db.VarChar(50)
  parecer        String?
  decidido_em    DateTime     @default(now()) @db.Timestamptz(6)
  solicitacoes   solicitacoes @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)
  etapas         etapas       @relation(fields: [etapa_id], references: [id], onDelete: Cascade)

  @@schema("workflow")
}

model assinaturas {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacao_id  String       @db.Uuid
  usuario_id      String       @db.Uuid
  hash_assinatura String       @db.VarChar(255)
  assinado_em     DateTime     @default(now()) @db.Timestamptz(6)
  solicitacoes    solicitacoes @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)

  @@schema("workflow")
}

model historicos {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitacao_id String       @db.Uuid
  de_status      String       @db.VarChar(50)
  para_status    String       @db.VarChar(50)
  usuario_id     String?      @db.Uuid
  motivo         String?
  registrado_em  DateTime     @default(now()) @db.Timestamptz(6)
  solicitacoes   solicitacoes @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)

  @@schema("workflow")
}

model eventos {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo          String   @db.VarChar(100)
  entidade      String   @db.VarChar(100)
  entidade_id   String   @db.VarChar(255)
  payload_jsonb Json
  usuario_id    String?  @db.Uuid
  unidade_id    String?  @db.Uuid
  criado_em     DateTime @default(now()) @db.Timestamptz(6)

  @@index([entidade, entidade_id], map: "idx_eventos_entidade")
  @@index([tipo], map: "idx_eventos_tipo")
  @@index([criado_em(sort: Desc)], map: "idx_eventos_criado_em")
  @@schema("workflow")
}
