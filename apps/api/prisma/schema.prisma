  docentes_substituicoes_docente_substituto_idTodocentes docentes     @relation("substituicoes_docente_substituto_idTodocentes", fields: [docente_substituto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unidades                                               unidades     @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agendamento_id], map: "idx_substituicoes_agendamento")
