  turmas        turmas[]

  @@unique([unidade_id, codigo], map: "uq_cursos_unidade_codigo")
  @@index([ativo], map: "idx_cursos_ativo")
  @@index([unidade_id], map: "idx_cursos_unidade")
  @@schema("academico")
