/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model agendamentos {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidade_id    String          @db.Uuid
  turma_id      String          @db.Uuid
  ambiente_id   String          @db.Uuid
  docente_id    String          @db.Uuid
  data_inicio   DateTime        @db.Timestamptz(6)
  data_fim      DateTime        @db.Timestamptz(6)
  status        String          @default("agendado") @db.VarChar(50)
  observacao    String?
  criado_por    String?         @db.Uuid
  criado_em     DateTime        @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime        @default(now()) @db.Timestamptz(6)
  ambientes     ambientes       @relation(fields: [ambiente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios      usuarios?       @relation(fields: [criado_por], references: [id], onUpdate: NoAction)
  docentes      docentes        @relation(fields: [docente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turmas        turmas          @relation(fields: [turma_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unidades      unidades        @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  substituicoes substituicoes[]

  @@index([ambiente_id, data_inicio, data_fim], map: "idx_agendamentos_ambiente")
  @@index([docente_id, data_inicio, data_fim], map: "idx_agendamentos_docente")
  @@index([turma_id], map: "idx_agendamentos_turma")
  @@index([unidade_id, data_inicio, data_fim], map: "idx_agendamentos_unidade_intervalo")
  @@schema("planejamento")
}

