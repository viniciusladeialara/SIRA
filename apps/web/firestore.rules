rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===== FUNCOES DE HELPER =====
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Verifica se usuario e Super Admin (Governança Total)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'viniciusladeialara@gmail.com' ||
        (userExists() && currentUserDoc().data.get('role', '') in ['SUPER_ADMIN', 'super_admin'])
      );
    }

    // Verifica se usuario e admin
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (userExists() && currentUserDoc().data.get('role', '') in ['ADMIN', 'admin'])
      );
    }
    
    // Verifica se usuario e operacional (USER)
    function isUser() {
      return isSignedIn() && userExists() && currentUserDoc().data.get('role', '') in ['USER', 'user'];
    }
    
    // Verifica se usuario e admin ou user
    function isAdminOrUser() {
      return isAdmin() || isUser();
    }
    
    // Verifica se usuario e professor
    function isTeacher() {
      return isSignedIn() && userExists() && currentUserDoc().data.get('role', '') in ['PROFESSOR', 'professor'];
    }

    // Verifica se usuario e escola parceira
    function isPartnerSchool() {
      return isSignedIn() && userExists() && currentUserDoc().data.get('role', '') in ['PARTNER_SCHOOL', 'partner_school'];
    }

    // Funcoes de Escopo (Fase 2)
    function userScope() {
      return currentUserDoc().data.get('scope', {});
    }

    function canAccessSchoolScope(schoolId) {
      let scope = userScope();
      return scope.get('schoolIds', []).size() > 0 
        ? schoolId in scope.schoolIds 
        : schoolId == currentUserDoc().data.get('escolaId', '');
    }

    function documentUnitId(data) {
      return data.get('unitId', 'caceres');
    }

    // Verifica se o usuário tem permissão para a unidade do documento
    function hasUnitAccess(data) {
      return isSignedIn() && (
        request.auth.token.email == 'viniciusladeialara@gmail.com' ||
        isAdmin() ||
        (
          userExists() && (
            !('unitIds' in currentUserDoc().data) ||
            currentUserDoc().data.unitIds == null ||
            currentUserDoc().data.get('unitIds', []).size() == 0 ||
            documentUnitId(data) in currentUserDoc().data.get('unitIds', ['caceres'])
          )
        )
      );
    }

    // Verifica se o usuário pode atualizar metadados da unidade
    function isValidMetadataUpdate(unitId) {
      return isSignedIn() && (
        request.auth.token.email == 'viniciusladeialara@gmail.com' ||
        isAdmin() ||
        (userExists() && unitId in currentUserDoc().data.get('unitIds', ['caceres']))
      );
    }

    // Usuario admin do sistema que nunca pode ser removido pelo cliente
    function isSystemAdminUser(data) {
      return data.email == 'viniciusladeialara@gmail.com' || data.get('role', '') in ['SUPER_ADMIN', 'super_admin'];
    }

    // USER so pode operar usuarios professores, sem trocar role/email/uid
    function isUserUpdatingProfessor() {
      return isUser() &&
        resource.data.role == 'PROFESSOR' &&
        request.resource.data.role == 'PROFESSOR' &&
        !isSystemAdminUser(resource.data) &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'isActive',
          'mustChangePassword',
          'phone',
          'phone1',
          'phone2',
          'unitId',
          'unitIds',
          'selectedUnitId',
          'teacherId',
          'updatedAt'
        ]);
    }
    
    // Validacao basica de dados
    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // Validacao de telefone (DDI + DDD + Numero = 12 ou 13 digitos)
    function isValidPhone(phone) {
      return phone == null || phone == "" || phone.matches('^[0-9]{12,13}$');
    }

    // ===== REGRAS DE ACESSO =====
    
    // Regras para cursos (leitura pública para BI/PublicView, escrita admin/user)
    match /courses/{courseId} {
      allow read: if true; 
      allow write: if isAdminOrUser();
    }
    
    // Regras para Plano de Curso e Plano de Ensino (Colecoes Root)
    match /curricular_units/{unitId} {
      allow read: if true;
      allow write: if isAdminOrUser();
    }
    match /capabilities/{capId} {
      allow read: if true;
      allow write: if isAdminOrUser();
    }
    match /knowledges/{knowId} {
      allow read: if true;
      allow write: if isAdminOrUser();
    }
    match /teacher_allocations/{allocId} {
      allow read: if true;
      allow write: if isAdminOrUser();
    }
    
    // Regras para professores (leitura para todos os usuários autenticados)
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create: if isAdminOrUser() && hasUnitAccess(request.resource.data);
      allow update: if (isAdminOrUser() && hasUnitAccess(resource.data) && hasUnitAccess(request.resource.data)) || (
        request.auth.uid == teacherId && (isTeacher() || isUser()) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt', 'status']) ||
          (isValidPhone(request.resource.data.get('phone1', '')) && isValidPhone(request.resource.data.get('phone2', '')))
        )
      );
      allow delete: if isAdminOrUser() && hasUnitAccess(resource.data);
    }
    
    // Regras para turmas (leitura pública para PublicView/BI, escrita admin/user)
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdminOrUser() && hasUnitAccess(request.resource != null ? request.resource.data : resource.data);
    }
    
    // Regras para ambientes/salas (leitura pública para PublicView/BI, escrita admin/user)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdminOrUser() && hasUnitAccess(request.resource != null ? request.resource.data : resource.data);
    }
    
    // Regras para agendamentos (leitura pública para PublicView/BI, escrita autenticada admin/user/teacher)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdminOrUser() || isTeacher()) && hasUnitAccess(request.resource.data);
      allow update: if isSignedIn() && hasUnitAccess(request.resource.data) && (
        isAdminOrUser() || 
        isTeacher() ||
        resource.data.teacherId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        (userExists() && resource.data.teacherId == currentUserDoc().data.get('teacherId', ''))
      );
      allow delete: if (isAdminOrUser() || (resource.data.createdBy == request.auth.uid && isTeacher())) && hasUnitAccess(resource.data);
    }
    
    // Regras para usuarios
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin() || (isUser() && resource.data.role == 'PROFESSOR');
      
      // Permitir que o usuário crie seu próprio documento se não existir (vindo do Auth com roles não-ADMIN)
      // Super admin cria qualquer usuário; Admin cria usuários comuns e parceiros (não admin); User cria professores.
      allow create: if (
        isSuperAdmin() || 
        (isAdmin() && request.resource.data.role in ['USER', 'PARTNER_SCHOOL', 'PROFESSOR']) ||
        (isUser() && request.resource.data.role == 'PROFESSOR')
      ) || (request.auth.uid == userId && 
        request.resource.data.role in ['USER', 'PROFESSOR', 'PARTNER_SCHOOL'] &&
        request.resource.data.isActive == true);

      // O próprio usuário pode editar dados não sensíveis do próprio cadastro.
      // Super admin pode editar qualquer usuário.
      // Admin pode editar usuários comuns (não pode editar outros ADMINs nem SUPER_ADMIN).
      allow update: if request.auth.uid == userId 
        ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid', 'isActive'])
        : (
          isSuperAdmin() && (
            !isSystemAdminUser(resource.data) ||
            (
              request.resource.data.email == resource.data.email &&
              request.resource.data.uid == resource.data.uid
            )
          )
        ) || (
          isAdmin() && !isSuperAdmin() &&
          resource.data.role != 'ADMIN' && resource.data.role != 'SUPER_ADMIN' &&
          request.resource.data.role != 'ADMIN' && request.resource.data.role != 'SUPER_ADMIN'
        ) || isUserUpdatingProfessor();

      // Super admin pode deletar qualquer um (exceto admin do sistema).
      // Admin só pode deletar usuários que não sejam ADMIN nem SUPER_ADMIN.
      allow delete: if (
        isSuperAdmin() && !isSystemAdminUser(resource.data)
      ) || (
        isAdmin() && !isSuperAdmin() && !isSystemAdminUser(resource.data) &&
        resource.data.role != 'ADMIN' && resource.data.role != 'SUPER_ADMIN'
      );
    }
    
    // Regras para audit logs (leitura admin, escrita restrita)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Permitir criação por qualquer usuário logado para logs de sistema
      allow update, delete: if false; // Audit logs devem ser imutáveis
    }
    
    // Regras para ausencias (leitura publica para BI, escrita admin e user)
    match /absences/{absenceId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }
    
    // Regras para uniformes e movimentacoes (leitura publica para BI, escrita restringida)
    match /uniforms/{uniformId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }
    match /uniform_movements/{movementId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }
    match /project_demands/{demandId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }
    
    // Regras para substituicoes (leitura admin/user/professor, escrita admin e user)
    match /substitutions/{substitutionId} {
      allow read: if isAdminOrUser() || isTeacher();
      allow write: if isAdminOrUser();
    }
    
    // Atribuições individuais de substituição (auditoria)
    match /substitution_assignments/{assignmentId} {
      allow read, write: if isAdminOrUser();
    }
    
    match /teacher_allocation/{allocId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }

    // Opções de alocação (status, cores, etc)
    match /allocation_options/{optionId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }

    // Regras para projetos (leitura por todos logados, escrita admin/user)
    match /projects/{projectId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }
    
    // Regras para trocas de agendamento (leitura admin/user/professor, escrita professor e admin/user)
    match /scheduleSwaps/{swapId} {
      allow read: if isAdminOrUser() || isTeacher();
      allow create: if isTeacher() || isAdminOrUser() || (
        hasRequiredFields([
          'swapCode',
          'requesterTeacherId',
          'requesterTeacherName',
          'requesterScheduleId',
          'requesterScheduleDetails',
          'targetTeacherId',
          'targetTeacherName',
          'targetScheduleId',
          'targetScheduleDetails',
          'status',
          'createdAt',
          'expiresAt'
        ]) && request.resource.data.status == 'pending'
      );
      allow update: if isAdminOrUser() || isTeacher() || (
        resource.data.targetTeacherId == request.auth.uid ||
        resource.data.requesterTeacherId == request.auth.uid ||
        (userExists() && (
          resource.data.targetTeacherId == currentUserDoc().data.get('teacherId', '') ||
          resource.data.requesterTeacherId == currentUserDoc().data.get('teacherId', '')
        ))
      );
      allow delete: if isAdmin();
    }

    // Regras para feriados (leitura por todos, escrita admin)
    match /holidays/{holidayId} {
      allow read: if true; // Public view access
      allow write: if isAdmin();
    }
    
    // Regras para ativos/equipamentos e relatorios (Gestao de Ativos)
    match /assets/{assetId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser() || isTeacher();
    }
    
    match /asset_reports/{reportId} {
      allow create: if isTeacher() || isAdminOrUser();
      allow read, update, delete: if isAdminOrUser();
    }

    // Regras para Checklists de Sala
    match /room_checklists/{checklistId} {
      allow read: if isAdminOrUser();
      allow create: if isAdminOrUser() || isTeacher();
    }

    // Regras para Vistorias de Sala e Cadeia de Custódia (Check-in / Check-out)
    match /room_inspections/{inspectionId} {
      allow read: if isAdminOrUser() || isTeacher();
      allow create: if isAdminOrUser() || isTeacher();
      allow update, delete: if isAdminOrUser();
    }

    // Regras para Problemas Relatados em Sala (Issues / Ocorrências)
    match /room_issues/{issueId} {
      allow read: if isAdminOrUser() || isTeacher();
      allow create: if isAdminOrUser() || isTeacher();
      allow update, delete: if isAdminOrUser();
    }

    // Regras para acompanhamento de escola parceira
    match /partner_school_attendance/{attendanceId} {
      allow read: if isAdminOrUser() || (isPartnerSchool() && canAccessSchoolScope(resource.data.escolaId));
      allow create: if isAdminOrUser() || isPartnerSchool();
      allow update, delete: if isAdminOrUser();
    }

    // Regras para cadastros de escolas parceiras
    match /schools/{schoolId} {
      allow read: if true; // Public view access
      allow write: if isAdmin() || isUser();
    }

    // Regras para turmas do diario (normalizado)
    match /diario_turmas/{turmaId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }

    // Regras para aulas do diario (normalizado)
    match /diario_aulas/{aulaId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }

    // Regras para frequencias do diario (normalizado)
    match /diario_frequencias/{freqId} {
      allow read: if true; // Public view access
      allow write: if isAdminOrUser();
    }

    // Regras para imports de diario
    match /imports_diario/{importId} {
      allow read, write: if isAdminOrUser();
    }

    // Regras para contratacao de professores (Módulo de Contratação)
    match /teacher_hiring/{hiringId} {
      allow read: if isAdmin() || isUser();
      allow write: if isAdmin();
    }

    // Regras para Conflitos e Lotes de Cópia (Somente ADMIN)
    match /schedule_conflicts/{conflictId} {
      allow read, write: if isAdmin();
    }
    match /schedule_copy_batches/{batchId} {
      allow read, write: if isAdmin();
    }

    // Regras para Configurações do Sistema (Leitura por todos autenticados, escrita somente ADMIN)
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regras para Unidades (Leitura pública para PublicView/BI, escrita se pertencer à unidade/admin)
    match /units/{unitId} {
      allow read: if true;
      allow write: if (isAdmin() || isUser()) && isValidMetadataUpdate(unitId);
    }

    // Regras para Acompanhamento Docente (SLI / PRD M365 - Exclusivo para Super Admin)
    match /teacher_monitoring/{monitoringId} {
      allow read, write: if isSuperAdmin();
    }

    // Regras para CORE Eventos (Leitura pública para o dashboard público/BI, escrita para autenticados)
    match /core_events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /core_event_aliases/{aliasId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /core_event_responses/{responseId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /core_event_imports/{importId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /core_event_issues/{issueId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
