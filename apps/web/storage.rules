rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /room_issues_photos/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024; // Máx 10MB
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
